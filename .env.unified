# ============================================================
# HDP Environment Configuration - Unified
# ============================================================
# Copy this file to .env and fill in your values
# Database
DATABASE_URL=sqlite:///./data/hdp_v2.db
# Alternatives (uncomment one):
# DATABASE_URL=postgresql://user:password@localhost:5432/hermezgan_db
# DATABASE_URL=mysql://user:password@localhost:3306/hermezgan_db

# Redis Cache & Session
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# API Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FASTAPI_ENV=development
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_VERSION=v1

# Map Configuration
REACT_APP_MAP_CENTER_LAT=27.2158
REACT_APP_MAP_CENTER_LNG=56.2808
REACT_APP_MAP_ZOOM=12
REACT_APP_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# External Map Services
MAPBOX_TOKEN=your-mapbox-token-here
NESHAN_API_KEY=your-neshan-api-key-here

# Routing Services
OSRM_SERVER=http://localhost:5000
ORS_API_KEY=your-ors-api-key-here

# Location Services
OSM_API_URL=https://nominatim.openstreetmap.org
GEOLOCATION_PROVIDER=osm

# NLP & Models
HF_MODEL_NAME=bert-base-persian-uncased
DEVICE=cpu
MODEL_CACHE_DIR=./models/cache

# LLM Configuration
OLLAMA_API_URL=http://localhost:11434
LLM_MODEL=llama2
GEMINI_API_KEY=your-gemini-api-key-here

# Voice Services
VOSK_MODEL_PATH=./models/vosk
TTS_PROVIDER=google
TTS_LANGUAGE=fa-IR

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlflow/artifacts
MLFLOW_REGISTRY_URI=sqlite:///mlflow/mlflow.db

# Monitoring & Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Bandari Engine
BANDARI_ENGINE_URL=http://localhost:5200
BANDARI_LLM_ENABLED=0
BANDARI_LLM_PROVIDER=anthropic

# Firebase (Optional)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-key
FIREBASE_CLIENT_EMAIL=your-firebase-email

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=60
