# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hermezgan_db

# Redis
REDIS_URL=redis://localhost:6379

# API
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# Frontend
REACT_APP_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# AI / LLM (new generic variables)
AI_PROVIDER=generic
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.0-flash

# Legacy compatibility for older config names
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# TTS (new generic variables)
TTS_PROVIDER=generic
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=eleven_multilingual_v2

# Legacy compatibility for older config names
ELEVENLABS_PROVIDER=generic
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
