# FastAPI Configuration
FASTAPI_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DB_PATH=/data/data/com.termux/files/home/hormozgan_geo_project/hormozgan_data/hormozgan_master_final.db
DATABASE_URL=sqlite:////data/data/com.termux/files/home/hormozgan_geo_project/hormozgan_data/hormozgan_master_final.db

# AI / LLM
AI_API_KEY=your_ai_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com

# Speech / Voice
TTS_API_KEY=your_tts_key_here
TTS_PROVIDER=elevenlabs
TTS_MODEL=elevenlabs_multilingual_v2
STT_API_KEY=your_stt_key_here
STT_PROVIDER=deepgram
STT_MODEL=general

# Optional generic keys
VOICE_API_KEY=your_voice_key_here
TEXT_TO_SPEECH_API_KEY=your_tts_key_here
SPEECH_TO_TEXT_API_KEY=your_stt_key_here

# NLP & Models
HF_MODEL_NAME=bert-base-persian-uncased
DEVICE=cpu
MODEL_CACHE_DIR=./models/cache

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Location Services
MAPBOX_TOKEN=your-mapbox-token-here
OSM_API_URL=https://nominatim.openstreetmap.org

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
